---
import { SOCIALS } from '../data/site';
const tilts = ['-1.5deg', '1deg', '-.5deg'];
---

<section id="contact" class="contact">
  <div class="rv head">
    <div class="hand kicker">our door's always open</div>
    <h2 class="h2">Get in touch</h2>
    <p>Questions about membership, events or sponsorship? Message us on any of these and an exec will get back to you.</p>
  </div>
  <ul class="socials">
    {SOCIALS.map((s, i) => (
      <li class="rv" style={`--d: ${i}`}>
        <a class="card lift" href={s.href} target="_blank" rel="noopener" style={`rotate: ${tilts[i]}`}>
          <svg aria-hidden="true" viewBox="0 0 24 24" set:html={s.icon} />
          <span class="net">{s.label}</span>
          <strong>{s.handle}</strong>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .contact { padding: clamp(40px, 6vw, 80px) var(--pad-x); text-align: center; scroll-margin-top: 40px; }
  .head p { margin: 14px auto 0; max-width: 520px; font-size: 17px; line-height: 1.6; color: var(--muted); }
  .socials {
    list-style: none; margin: 40px auto 0; padding: 0; max-width: 860px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 22px;
  }
  .card {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    height: 100%; padding: 30px 20px 26px;
    background: #fff; border-radius: 18px;
    box-shadow: 0 8px 22px rgba(90,50,60,.12);
    transition: rotate .25s, scale .25s, box-shadow .25s;
  }
  .card svg { width: 58px; height: 58px; margin-bottom: 10px; color: #EE929E; transition: color .25s; }
  .card:hover svg, .card:focus-visible svg { color: var(--rose); }
  .net { font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .card strong { font-size: 19px; line-height: 1.3; color: var(--ink); }

  /* phones: compact rows, icon on the left */
  @media (max-width: 560px) {
    .socials { gap: 14px; margin-top: 28px; }
    .card { display: grid; grid-template-columns: auto 1fr; column-gap: 16px; row-gap: 2px; align-items: center; padding: 16px 20px; text-align: left; }
    .card svg { grid-row: span 2; width: 44px; height: 44px; margin: 0; }
    .card strong { font-size: 17px; }
  }
</style>
