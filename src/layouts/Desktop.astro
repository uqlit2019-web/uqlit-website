---
import '../styles/global.css';
import MenuBar from '../components/MenuBar.astro';
import Dock from '../components/Dock.astro';
import { RUBRIC_MEMBERSHIP_URL, SOCIALS } from '../data/site';

export type PageKey = 'home' | 'about' | 'team' | 'events';

interface Props {
  page: PageKey;
  title: string;        // <title>
  windowTitle: string;  // shown in the window's title bar
  description?: string;
}

const {
  page,
  title,
  windowTitle,
  description = 'UQLIT (UQ Ladies in Technology): a supportive community for women and gender minorities in tech at UQ. Membership is $2 for the whole year.',
} = Astro.props;

const joinHref = RUBRIC_MEMBERSHIP_URL;
// Full https:// addresses: chat apps and search engines ignore relative links for these
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.jpg', Astro.site).href;
// Tells Google that uqlit.com and our socials belong to the same society (shown on Home)
const orgData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'UQ Ladies in Technology',
  alternateName: 'UQLIT',
  url: 'https://uqlit.com/',
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  description: 'A supportive community for women and gender minorities in tech at the University of Queensland.',
  sameAs: [...SOCIALS.map((s) => s.href), 'https://linktr.ee/uqlit'],
};
// Position of this page's tile in the dock (LIT = 0), so the window opens out of it.
const tileIndex = { home: 0, about: 1, team: 2, events: 3 }[page];

// Footer links: every page except the one you're on, then Sponsors.
const footerLinks = [
  { key: 'home', label: 'Home', href: '/' },
  { key: 'about', label: 'About', href: '/about/' },
  { key: 'team', label: 'Team', href: '/team/' },
  { key: 'events', label: 'Events', href: '/events/' },
]
  .filter((l) => l.key !== page)
  .concat({ key: 'sponsors', label: 'Sponsors', href: page === 'home' ? '#sponsors' : '/#sponsors' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EBC4C4" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- Link previews (Instagram, Messenger, iMessage, Facebook, LinkedIn, Discord…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UQLIT" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="UQ Ladies in Technology: the UQLIT community together at an event" />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {page === 'home' && <script type="application/ld+json" set:html={JSON.stringify(orgData)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&family=Instrument+Sans:wght@400..700&family=Kalam:wght@300;400;700&family=DM+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      // Turn on scroll reveals only when scripts run and motion is allowed (see .rv/.dev/.grow in global.css)
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anim');
      }
    </script>
    {page === 'home' && (
      // The splash (cursor opens the LIT app) plays whenever Home loads,
      // except when arriving at a section like /#sponsors. Any click or key skips it.
      <script is:inline>
        if (!location.hash && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          var root = document.documentElement;
          root.classList.add('splash');
          var skip = function () {
            root.classList.remove('splash');
            removeEventListener('pointerdown', skip);
            removeEventListener('keydown', skip);
          };
          addEventListener('pointerdown', skip);
          addEventListener('keydown', skip);
          setTimeout(function () { // intro has finished by now: stop listening, leave the page as it is
            removeEventListener('pointerdown', skip);
            removeEventListener('keydown', skip);
          }, 4500);
        }
      </script>
    )}
  </head>
  <body>
    <div class="desktop" style={`--tile-i: ${tileIndex}`}>
      <a class="skip" href="#content">Skip to content</a>
      <MenuBar page={page} joinHref={joinHref} />

      <div class="win-wrap" id="win-wrap">
        <main class="win" id="content">
          <div class="titlebar">
            <div class="tls">
              <button type="button" class="tlb" data-win="close" aria-label="Close window" style="background:#EC6A5E"><span class="tg" aria-hidden="true">×</span></button>
              <button type="button" class="tlb" data-win="min" aria-label="Minimise window to the dock" style="background:#F4BE4F"><span class="tg" aria-hidden="true">−</span></button>
              <button type="button" class="tlb" data-win="full" aria-label="Toggle full screen" aria-pressed="false" style="background:#61C454"><span class="tg" aria-hidden="true">+</span></button>
            </div>
            <div class="wtitle">UQLIT — {windowTitle}</div>
            <div class="ld" aria-hidden="true"></div>
          </div>

          <slot />

          <footer class="foot">
            <div class="foot-brand">
              <img src="/assets/logo-lit.png" alt="" width="42" height="42" />
              <span><strong>UQ Ladies in Technology</strong><br />© {new Date().getFullYear()} UQLIT</span>
            </div>
            <div class="foot-links">
              {footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
              <a href={joinHref} class="foot-join" target="_blank" rel="noopener">Join on Rubric ↗</a>
            </div>
            <div class="foot-social">
              {SOCIALS.map((s) => (
                <a href={s.href} target="_blank" rel="noopener" aria-label={`${s.label}: ${s.handle}`} title={`${s.label} · ${s.handle}`}>
                  <svg aria-hidden="true" viewBox="0 0 24 24" set:html={s.icon} />
                </a>
              ))}
            </div>
          </footer>
        </main>
      </div>

      <div class="hidden-msg" id="hidden-msg" role="status" hidden>
        <span id="hidden-text"></span>
        <span aria-hidden="true" class="bob">↓</span>
      </div>

      <Dock page={page} joinHref={joinHref} />

      {page === 'home' && (
        <Fragment>
          <div class="rip" aria-hidden="true"></div>
          <svg class="cur" aria-hidden="true" width="30" height="30" viewBox="0 0 24 24"><path d="M4 2v18l4.5-4.5L12 22l2.5-1.2L11 14.5h6.5z" fill="#FFFFFF" stroke="#3A2F2F" stroke-width="1.5" stroke-linejoin="round" /></svg>
        </Fragment>
      )}
    </div>

    <script>
      const wrap = document.getElementById('win-wrap')!;
      const win = wrap.querySelector('.win') as HTMLElement;
      const msg = document.getElementById('hidden-msg')!;
      const msgText = document.getElementById('hidden-text')!;
      const lit = document.getElementById('dock-lit')!;
      const fullBtn = document.querySelector('[data-win="full"]')!;
      const onHome = location.pathname === '/';

      function hide(how: 'closed' | 'min') {
        // Shrink toward the LIT tile, wherever the page is scrolled to.
        const w = wrap.getBoundingClientRect();
        const t = lit.getBoundingClientRect();
        wrap.style.transformOrigin = `${t.left + t.width / 2 - w.left}px ${t.top + t.height / 2 - w.top}px`;
        wrap.classList.add('is-hidden');
        msgText.textContent = how === 'closed'
          ? 'window closed. click LIT in the dock to bring it back'
          : 'tucked away in the dock. click LIT to open it again';
        msg.hidden = false;
        lit.focus({ preventScroll: true });
      }

      function show() {
        wrap.classList.remove('is-hidden');
        msg.hidden = true;
      }

      document.querySelector('[data-win="close"]')!.addEventListener('click', () => hide('closed'));
      document.querySelector('[data-win="min"]')!.addEventListener('click', () => hide('min'));
      fullBtn.addEventListener('click', () => {
        const full = win.classList.toggle('is-full');
        fullBtn.setAttribute('aria-pressed', String(full));
      });

      lit.addEventListener('click', (e) => {
        if (wrap.classList.contains('is-hidden')) {
          e.preventDefault();
          show();
        } else if (onHome) {
          e.preventDefault();
          window.scrollTo({ top: 0 });
        }
      });

      // ---------- Desktop toys (from the original design) ----------
      const desktop = document.querySelector('.desktop') as HTMLElement;
      const calm = matchMedia('(prefers-reduced-motion: reduce)');
      const SPARK = 'M12 1c.6 5.2 2.8 9.4 11 11-8.2 1.6-10.4 5.8-11 11-.6-5.2-2.8-9.4-11-11C9.2 10.4 11.4 6.2 12 1z';
      let toyId = 0;

      // Sparkle trail behind the mouse (not on touch screens or with reduced motion)
      let lastSpark = 0;
      desktop.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse' || calm.matches) return;
        const now = performance.now();
        if (now - lastSpark < 70) return;
        lastSpark = now;
        const id = ++toyId;
        const size = 10 + (id % 3) * 4;
        const fill = ['#B8405F', '#D9708A', '#E8B04A'][id % 3];
        const s = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        s.setAttribute('class', 'spark');
        s.setAttribute('viewBox', '0 0 24 24');
        s.setAttribute('aria-hidden', 'true');
        s.style.cssText = `left:${e.clientX}px;top:${e.clientY}px;width:${size}px;height:${size}px`;
        s.innerHTML = `<path fill="${fill}" d="${SPARK}"/>`;
        document.body.appendChild(s);
        setTimeout(() => s.remove(), 760);
      });

      // Click the pink desktop (not the window) to drop a sticker; the last 10 stay
      const stickers: HTMLElement[] = [];
      const kinds = [
        `<svg width="30" height="30" viewBox="0 0 24 24" fill="#B8405F"><path d="M12 21s-8.5-5.2-8.5-11.2A4.8 4.8 0 0 1 12 7a4.8 4.8 0 0 1 8.5 2.8C20.5 15.8 12 21 12 21z"/></svg>`,
        `<img src="/assets/logo-lit.png" alt="" width="34" height="34">`,
        `<svg width="30" height="30" viewBox="0 0 24 24" fill="#E8B04A"><path d="${SPARK}"/></svg>`,
        `<span class="stick-tag">#women_in_stem</span>`,
      ];
      desktop.addEventListener('click', (e) => {
        if (e.target !== desktop) return;
        const r = desktop.getBoundingClientRect();
        const id = ++toyId;
        const k = id % 4;
        const el = document.createElement('div');
        el.className = k === 3 ? 'stick stick-wide' : 'stick';
        el.setAttribute('aria-hidden', 'true');
        el.style.cssText = `left:${e.clientX - r.left}px;top:${e.clientY - r.top}px;rotate:${((id * 37) % 40) - 20}deg`;
        el.innerHTML = kinds[k];
        desktop.appendChild(el);
        stickers.push(el);
        if (stickers.length > 10) stickers.shift()!.remove();
      });

      // ---------- "Window is open" signal ----------
      // While the window grows open out of the dock, the whole page is shrunk into a tiny box on
      // screen, so anything watching for "scrolled into view" would fire for everything at once
      // (counting the numbers, dropping the polaroids, printing the receipt) before anyone sees it.
      // Scroll-triggered effects wait for this signal instead.
      const root = document.documentElement;
      const markOpen = () => {
        if (root.dataset.winOpen) return;
        root.dataset.winOpen = '1';
        dispatchEvent(new Event('uqlit:window-open'));
      };
      if (win.getAnimations().length) {
        win.addEventListener('animationend', (e) => { if (e.target === win) markOpen(); });
        setTimeout(markOpen, 4500); // safety net, in case the animation never reports finishing
      } else {
        markOpen();
      }
      const whenWindowOpen = (fn: () => void) => {
        if (root.dataset.winOpen) fn();
        else addEventListener('uqlit:window-open', fn, { once: true });
      };

      // ---------- Scroll effects (work in every browser) ----------
      if (document.documentElement.classList.contains('anim')) {
        // Reveal cards and photos, develop photos and grow underlines as they come into view
        const reveal = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              reveal.unobserve(e.target);
            }
          }
        }, { rootMargin: '0px 0px -8% 0px' });
        // Handwritten notes write themselves: split each into letters that ink in one by one.
        // Screen readers get the plain text; the letters are hidden from them.
        const escHtml = (t: string) => t.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
        document.querySelectorAll<HTMLElement>('.kicker, .join-kicker').forEach((el) => {
          const text = el.textContent ?? '';
          let i = 0;
          const letters = text.split(/(\s+)/).map((part) =>
            /^\s+$/.test(part)
              ? part
              : `<span class="w">${[...part].map((ch) => `<span class="ch-w" style="--i:${i++}">${escHtml(ch)}</span>`).join('')}</span>`,
          ).join('');
          el.innerHTML = `<span class="sr-only">${escHtml(text)}</span><span aria-hidden="true">${letters}</span>`;
          el.classList.add('write');
        });

        let pending = [...document.querySelectorAll<HTMLElement>('.rv, .dev, .grow, .fall, .stamp, .write')];

        // A fast jump (section link, End key) can skip right past an element without it ever
        // crossing the screen, so also reveal anything that's already above the bottom of the screen.
        let sweepQueued = false;
        const sweep = () => {
          sweepQueued = false;
          pending = pending.filter((el) => {
            if (el.classList.contains('in')) return false;
            if (el.getBoundingClientRect().top < innerHeight) {
              el.classList.add('in');
              reveal.unobserve(el);
              return false;
            }
            return true;
          });
        };
        // Start watching only once the window is fully open (see the signal above)
        whenWindowOpen(() => {
          pending.forEach((el) => reveal.observe(el));
          sweep();
          addEventListener('scroll', () => { if (!sweepQueued && pending.length) { sweepQueued = true; requestAnimationFrame(sweep); } }, { passive: true });
        });

        // Floating stickers drift up as you scroll past (down by --y at the bottom of the screen, up by --y at the top)
        const floaters = [...document.querySelectorAll<HTMLElement>('.flt')];
        if (floaters.length) {
          let queued = false;
          const drift = () => {
            queued = false;
            const vh = innerHeight;
            for (const el of floaters) {
              const r = el.parentElement!.getBoundingClientRect();
              if (r.bottom < 0 || r.top > vh) continue;
              const p = Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)));
              const y = parseFloat(getComputedStyle(el).getPropertyValue('--y')) || 50;
              el.style.translate = `0 ${(y * (1 - 2 * p)).toFixed(1)}px`;
            }
          };
          addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(drift); } }, { passive: true });
          drift();
        }

        // Depth: the dotted pink desktop scrolls a little slower than the window
        let bgQueued = false;
        const desktopBg = () => {
          bgQueued = false;
          desktop.style.backgroundPositionY = `${(scrollY * 0.35).toFixed(1)}px`;
        };
        addEventListener('scroll', () => { if (!bgQueued) { bgQueued = true; requestAnimationFrame(desktopBg); } }, { passive: true });
      }

      // ---------- The dock follows the section you're in ----------
      // Home: Upcoming events lights Events, Sponsors lights the heart.
      // Any page with a join band (Home, About) lights the Join on Rubric ticket there.
      // Otherwise the current page's tile stays lit.
      {
        const spySections: [string, string][] = [['events', 'events'], ['sponsors', 'sponsors'], ['join', 'join']]
          .filter(([id]) => document.getElementById(id) && (onHome || id === 'join')) as [string, string][];
        const tiles = new Map([...document.querySelectorAll<HTMLElement>('.dock [data-tile]')].map((t) => [t.dataset.tile!, t]));
        // each tile's resting finish: gl (light), gd (dark ticket) or ga (current page)
        const base = new Map([...tiles].map(([k, t]) => [k, ['ga', 'gd', 'gl'].find((c) => t.classList.contains(c))!]));
        const home = [...tiles].find(([, t]) => t.classList.contains('ga'))?.[0] ?? 'home';
        base.set(home, 'gl'); // the current page's tile dims while another one is lit
        const dot = document.querySelector<HTMLElement>('.dock .litdot');
        let current = home;
        let spyQueued = false;
        const spy = () => {
          spyQueued = false;
          const line = innerHeight * 0.45;
          let next = home;
          for (const [id, tile] of spySections) {
            const r = document.getElementById(id)!.getBoundingClientRect();
            if (r.top <= line && r.bottom > line) next = tile;
          }
          if (next === current) return;
          const prev = tiles.get(current);
          prev?.classList.replace('ga', base.get(current)!);
          const el = tiles.get(next);
          el?.classList.replace(base.get(next)!, 'ga');
          if (el && dot) el.appendChild(dot);
          current = next;
        };
        if (spySections.length) {
          addEventListener('scroll', () => { if (!spyQueued) { spyQueued = true; requestAnimationFrame(spy); } }, { passive: true });
          spy();
        }
      }

      // Links like /#sponsors: the browser jumps while the window is still growing open,
      // so it measures the shrunken window and lands in the wrong place. Work out the
      // section's real position from the layout (transforms don't affect offsetTop) and go there.
      function jumpToHash() {
        const id = decodeURIComponent(location.hash.slice(1));
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        let y = 0;
        for (let n: HTMLElement | null = target; n; n = n.offsetParent as HTMLElement | null) y += n.offsetTop;
        const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
        window.scrollTo({ top: y - margin, behavior: 'instant' });
      }
      if (location.hash) {
        let userScrolled = false;
        for (const ev of ['wheel', 'touchmove', 'keydown']) {
          window.addEventListener(ev, () => (userScrolled = true), { once: true, passive: true });
        }
        const again = () => { if (!userScrolled) jumpToHash(); };
        jumpToHash();
        window.addEventListener('load', again, { once: true }); // after images/fonts settle
        win.addEventListener('animationend', (e) => { if (e.target === win) again(); }); // after the window opens
      }
    </script>
  </body>
</html>

<style>
  :root {
    --tile: 52px;
    --gap: 16px;
  }
  @media (max-width: 560px) {
    :root { --tile: 40px; --gap: 9px; }
  }

  .desktop {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: clip;
    background-color: var(--blush);
    background-image: radial-gradient(rgba(255,249,242,.55) 1.5px, transparent 1.6px);
    background-size: 26px 26px;
    display: flex;
    flex-direction: column;
    /* Horizontal offset of this page's dock tile from the screen centre.
       Dock row = 6 tiles + 6 gaps + 1px separator. */
    --dock-w: calc(6 * var(--tile) + 6 * var(--gap) + 1px);
    --tile-x: calc(var(--tile) / 2 - var(--dock-w) / 2 + var(--tile-i) * (var(--tile) + var(--gap)));
  }

  .skip {
    position: absolute; left: 12px; top: -60px; z-index: 100;
    background: var(--ink); color: var(--cream);
    padding: 10px 14px; border-radius: 8px; font-weight: 600;
  }
  .skip:focus { top: 48px; }

  /* ---------- Window ---------- */
  .win-wrap {
    position: relative; z-index: 1;
    pointer-events: none;
    max-height: 30000px;
    transition: transform .5s cubic-bezier(.5,0,.2,1), opacity .4s ease, max-height 0s linear 0s;
  }
  .win-wrap.is-hidden {
    transform: scale(.04);
    opacity: 0;
    max-height: 0;
    overflow: clip;
    transition: transform .5s cubic-bezier(.5,0,.2,1), opacity .4s ease, max-height 0s linear .5s;
  }

  .win {
    display: block;
    width: min(1180px, calc(100% - 28px));
    margin: 28px auto 0;
    pointer-events: auto;
    background: var(--cream);
    border-radius: 16px;
    border: 1px solid rgba(120,106,106,.3);
    box-shadow: 0 30px 70px rgba(90,50,60,.28), 0 2px 0 rgba(255,255,255,.7) inset;
    overflow: clip;
    transition: width .45s ease, margin .45s ease, border-radius .45s ease;
  }
  .win.is-full { width: 100%; margin: 0; border-radius: 0; }
  .is-hidden .win { pointer-events: none; }
  @media (max-width: 560px) {
    .win { width: calc(100% - 16px); margin-top: 12px; border-radius: 12px; }
  }

  .titlebar {
    position: relative;
    height: 44px;
    display: flex; align-items: center;
    padding: 0 18px;
    border-bottom: 1px solid rgba(120,106,106,.14);
  }
  .tls { display: flex; gap: 8px; position: relative; z-index: 2; }
  .tlb {
    position: relative;
    width: 14px; height: 14px; padding: 0;
    border: 0; border-radius: 50%;
    cursor: var(--cursor-link);
    display: flex; align-items: center; justify-content: center;
  }
  .tlb::before { content: ""; position: absolute; inset: -8px; }
  .tg { font: 700 10px/1 sans-serif; color: rgba(60,30,30,.8); opacity: 0; transition: opacity .15s; }
  .tls:hover .tg, .tlb:focus-visible .tg { opacity: 1; }
  .wtitle {
    position: absolute; left: 0; right: 0;
    text-align: center; font-size: 13px; color: var(--muted);
    pointer-events: none;
  }
  @media (max-width: 420px) {
    .wtitle { padding-left: 60px; }
  }
  .ld {
    position: absolute; left: 0; right: 0; bottom: -1px;
    height: 3px; background: var(--rose);
    opacity: 0;
  }

  /* ---------- Footer ---------- */
  .foot {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 18px 32px;
    padding: 28px var(--pad-x);
    border-top: 1px solid rgba(120,106,106,.2);
    font-size: 14px; color: var(--muted);
  }
  .foot-brand { display: flex; align-items: center; gap: 12px; }
  .foot-brand img { width: 42px; height: 42px; object-fit: contain; }
  .foot-brand strong { color: var(--ink); }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 22px; font-weight: 500; }
  .foot-links a:hover { color: var(--rose); }
  .foot-join { color: var(--rose); font-weight: 700; }
  .foot-social { display: flex; gap: 14px; }
  .foot-social a { display: flex; color: #EE929E; transition: color .2s, translate .2s; }
  .foot-social a:hover, .foot-social a:focus-visible { color: var(--rose); translate: 0 -2px; }
  .foot-social svg { width: 26px; height: 26px; }

  /* ---------- Hidden-window message ---------- */
