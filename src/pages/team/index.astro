---
import Desktop from '../../layouts/Desktop.astro';
---

<Desktop page="team" title="Team · UQLIT" windowTitle="Meet the team">
  <section class="placeholder">
    <p class="hand pop" style="--d: 0">coming soon ♡</p>
    <h1 class="h1 pop" style="--d: 1">Meet the team</h1>
  </section>
</Desktop>

<style>
  .placeholder { padding: clamp(48px, 8vw, 120px) var(--pad-x); min-height: 50vh; }
  .placeholder .hand { margin: 0 0 18px; font-size: 23px; color: var(--rose); rotate: -2deg; display: inline-block; }
</style>
