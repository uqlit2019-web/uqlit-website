---
import Desktop from '../layouts/Desktop.astro';
import EventCard from '../components/EventCard.astro';
import JoinBand from '../components/JoinBand.astro';
import Sponsors from '../components/Sponsors.astro';
import { upcomingEvents } from '../data/events';
import { RUBRIC_MEMBERSHIP_URL, RUBRIC_EVENTS_URL } from '../data/site';

// Typing headline: each character is its own span so it can type in one by one.
const words = ['A', 'place', 'to', 'belong', 'in', 'tech.'];
let charIndex = 0;
const headline = words.map((w) => ({
  word: w,
  chars: [...w].map((c) => ({ c, i: charIndex++ })),
}));
const caretAt = charIndex;

const marquee = 'women in STEM ✦ mentorship ✦ LIT Gala ✦ sponsor panels ✦ trivia night ✦ paint and sip ✦ high frequency networking ✦ 352 members ✦ ';

const stats = [
  { from: 0, to: 352, suf: '', label: 'members this year', bg: '#FFFFFF', tilt: '-2deg' },
  { from: 1900, to: 2019, suf: '', label: 'founded, and now entering our 9th year', bg: 'var(--blush-3)', tilt: '1.5deg' },
  { from: 0, to: 2, suf: '×', label: 'EAIT Club of the Year winners, 2022 & 2025', bg: '#FFFFFF', tilt: '-1deg', shine: true },
  { from: 0, to: 12, suf: '+', label: 'career and community events this year', bg: '#F3E4E4', tilt: '2deg' },
];

const pillars = [
  { n: 1, title: 'Community', text: 'Find your first mentors and your closest friends, in a place where you belong.', bg: '#FFFFFF', tilt: '-2deg' },
  { n: 2, title: 'Confidence', text: 'Feel seen, valued and encouraged to explore your potential.', bg: 'var(--blush-3)', tilt: '1.5deg', drop: true },
  { n: 3, title: 'Industry', text: 'Connect with industry and learn from our industry representatives.', bg: '#FFFFFF', tilt: '-1deg' },
];

const photos = [
  { src: '/assets/events/trivia1.jpg', alt: 'Members smiling together around a table at trivia night', cap: 'TRIVIA NIGHT', flex: '1.2 1 320px', h: 250, pos: '50% 40%', tilt: '-2deg' },
  { src: '/assets/events/paintnsip4.jpg', alt: 'Members painting mini canvases at a long table outdoors', cap: 'PAINT AND SIP', flex: '1 1 240px', h: 250, pos: 'center', tilt: '2deg' },
  { src: '/assets/events/eaitcarnival.jpg', alt: 'Crowds of students at the UQLIT stall at the EAIT carnival', cap: 'OUT ON CAMPUS', flex: '1.6 1 420px', h: 230, pos: 'center', tilt: '1deg' },
  { src: '/assets/events/litgala19.jpg', alt: 'A full room listening to speakers at the LIT Gala', cap: 'LIT GALA', flex: '1.5 1 360px', h: 250, pos: 'center 30%', tilt: '-1.5deg' },
  { src: '/assets/events/hfn4.jpg', alt: 'Students and industry guests mingling at High Frequency Networking', cap: 'HIGH FREQUENCY NETWORKING', flex: '1.5 1 360px', h: 250, pos: 'center', tilt: '1.5deg' },
  { src: '/assets/events/mockinterviews4.jpg', alt: 'Students practising interviews with industry guests at round tables', cap: 'MOCK INTERVIEWS', flex: '1.2 1 260px', h: 250, pos: 'center', tilt: '-1deg' },
];

// A few extra so the page can drop ones that pass between rebuilds (see script below).
const upcoming = upcomingEvents().slice(0, 6);
const sparkle = 'M12 1c.6 5.2 2.8 9.4 11 11-8.2 1.6-10.4 5.8-11 11-.6-5.2-2.8-9.4-11-11C9.2 10.4 11.4 6.2 12 1z';
---

<Desktop page="home" title="UQLIT · UQ Ladies in Technology" windowTitle="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-copy">
      <div class="hand hi pop" style="--d: 0">hi, we're UQLIT ♡</div>
      <h1 class="h1" aria-label="A place to belong in tech.">
        {headline.map(({ word, chars }, wi) => (
          <Fragment>
            {wi > 0 && ' '}
            {word === 'belong' ? (
              <em class="accent">
                <span class="word">
                  {chars.map(({ c, i }) => <span class="ch" aria-hidden="true" style={`--i: ${i}`}>{c}</span>)}
                  <svg class="ul" aria-hidden="true" viewBox="0 0 200 14" preserveAspectRatio="none" fill="none" stroke="#D9708A" stroke-width="5" stroke-linecap="round"><path d="M3 9C40 2 70 14 105 7S170 3 197 8" pathLength="1" /></svg>
                </span>
              </em>
            ) : (
              <span class="word">
                {chars.map(({ c, i }) => <span class="ch" aria-hidden="true" style={`--i: ${i}`}>{c}</span>)}
              </span>
            )}
          </Fragment>
        ))}<span class="caret" aria-hidden="true" style={`--n: ${caretAt}`}></span>
      </h1>
      <p class="lede pop" style="--d: 2">UQ Ladies in Technology is a supportive community where you find your first mentors, your confidence and your closest friends.</p>
      <div class="ctas pop" style="--d: 3">
        <a class="btn btn-primary" href={RUBRIC_MEMBERSHIP_URL} target="_blank" rel="noopener">Join on Rubric <span aria-hidden="true">↗</span></a>
        <a class="btn btn-outline" href="/events/">See upcoming events</a>
      </div>
      <div class="hand price pop" style="--d: 4">membership is $2 for the whole year</div>
    </div>

    <!-- Scrapbook collage -->
    <div class="collage">
      <div class="blob pop" style="--d: 1"></div>
      <div class="flt c-photo" style="--y: 30px">
        <figure class="polaroid pop lift taped" style="--d: 2">
          <img src="/assets/events/hfn10.jpg" alt="Two UQLIT members sharing a hug at High Frequency Networking" width="1600" height="1067" />
          <figcaption class="hand">CLOSEST FRIENDS FOUND HERE</figcaption>
        </figure>
      </div>
      <div class="flt c-logo" style="--y: 60px">
        <div class="logo-sticker pop wig lift" style="--d: 3"><img src="/assets/logo-lit.png" alt="UQLIT lightbulb logo" /></div>
      </div>
      <div class="flt c-note" style="--y: 44px">
        <div class="note hand pop lift taped" style="--d: 4">#women_in_stem</div>
      </div>
      <svg aria-hidden="true" class="c-spark pop" style="--d: 5" viewBox="0 0 24 24" fill="#B8405F"><path d={sparkle} /></svg>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="marq-track">
      <span>{marquee}{marquee}</span>
      <span>{marquee}{marquee}</span>
    </div>
  </div>

  <!-- What we do -->
  <section class="wwd">
    <div class="rv intro">
      <h2 class="h2">What we do</h2>
      <div class="rule grow"></div>
      <p>UQLIT is more than a society, it's a supportive community and a place to belong. In a male-dominated industry, we know how important it is for members to feel seen, valued and encouraged to explore their potential.</p>
      <p class="muted">Many of our members find their first mentors, their confidence, and their closest friends here, and that support carries them well beyond university.</p>
    </div>
    <div class="stats">
      {stats.map((s, i) => (
        <div class="stat rv lift taped" style={`--d: ${i}; background: ${s.bg}; rotate: ${s.tilt}`}>
          <div class:list={['num', 'cnt', { shine: s.shine }]} style={`--from: ${s.from}; --to: ${s.to}; --suf: '${s.suf}'`} tabindex="0">
            <span class="sr-only">{s.to}{s.suf}</span>
          </div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
    <p class="rv nominated">Nominated three times for EAIT Club of the Year.</p>
    <div class="pillars">
      {pillars.map((p, i) => (
        <div class:list={['pillar', 'rv', 'lift', 'taped', { drop: p.drop }]} style={`--d: ${i}; background: ${p.bg}; rotate: ${p.tilt}`}>
          <div class="hand no">no. {p.n}</div>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Life at UQLIT -->
  <section class="moments">
    <div class="rv">
      <div class="hand kicker">peek inside the scrapbook</div>
      <h2 class="h2">Life at UQLIT</h2>
    </div>
    <div class="gallery">
      {photos.map((p, i) => (
        <figure class="polaroid rv lift taped" style={`--d: ${i % 3}; flex: ${p.flex}; rotate: ${p.tilt}`}>
          <img src={p.src} alt={p.alt} loading="lazy" class="dev" style={`height: ${p.h}px; object-position: ${p.pos}`} />
          <figcaption class="hand">{p.cap}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Upcoming events -->
  <section id="events" class="upcoming">
    <div class="rv up-head">
      <div>
        <div class="hand kicker">pencil it in</div>
        <h2 class="h2">Upcoming events</h2>
      </div>
      <a class="btn btn-outline small" href="/events/">All events →</a>
    </div>
    <div class="cards" id="home-events">
      {upcoming.map((e, i) => <EventCard event={e} index={i} />)}
    </div>
    <p class="empty hand" id="home-events-empty" hidden={upcoming.length > 0}>
      nothing on the calendar just yet. new events land on <a href={RUBRIC_EVENTS_URL} target="_blank" rel="noopener">Rubric</a> first ♡
    </p>
  </section>

  <JoinBand />
  <Sponsors />
</Desktop>

<script>
  // Count-up stat stickers: run when each one scrolls into view; hovering replays it.
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('.cnt');
  if (!calm && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const from = Number(getComputedStyle(el).getPropertyValue('--from')) || 0;
      const to = Number(getComputedStyle(el).getPropertyValue('--to')) || 0;
      const start = performance.now();
      const dur = 1400;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - t, 3);
        el.style.setProperty('--num', String(Math.round(from + (to - from) * eased)));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          run(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.6 });
    counters.forEach((el) => {
      el.style.setProperty('--num', getComputedStyle(el).getPropertyValue('--from').trim() || '0');
      io.observe(el);
      el.addEventListener('mouseenter', () => run(el));
      el.addEventListener('focus', () => run(el));
    });
  }

  // The site is built ahead of time, so hide any event that has passed since the last build
  // and show at most three.
  const list = document.getElementById('home-events');
  if (list) {
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Australia/Brisbane' }).format(new Date());
    let shown = 0;
    list.querySelectorAll<HTMLElement>('[data-date]').forEach((card) => {
      const keep = card.dataset.date! >= today && shown < 3;
      if (keep) shown++;
      card.hidden = !keep;
    });
    document.getElementById('home-events-empty')!.hidden = shown > 0;
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 24px 40px;
    padding: clamp(28px, 5vw, 64px) var(--pad-x) clamp(36px, 5vw, 56px);
  }
  .hero-copy { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .hi { font-size: 23px; color: var(--rose); rotate: -2deg; align-self: flex-start; }
  .word { display: inline-block; white-space: nowrap; position: relative; }
  .accent { color: var(--rose); font-style: normal; }
  .ul { position: absolute; left: -2%; bottom: -6px; width: 104%; height: 14px; }
  .caret {
    display: inline-block; width: 3px; height: .8em;
    margin-left: .08em; vertical-align: -.02em;
    background: var(--rose);
  }
  .lede { margin: 0; font-size: 18px; line-height: 1.6; color: var(--muted); max-width: 480px; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 4px; }
  .price { font-weight: 400; font-size: 18px; color: var(--muted); }

  .collage { flex: 1 1 340px; min-width: 0; position: relative; height: 480px; max-width: 520px; margin: 0 auto; }
  .blob { position: absolute; inset: 20px 10px 20px 30px; border-radius: 46% 54% 52% 48% / 52% 44% 56% 48%; background: var(--blush-2); }
  .c-photo { position: absolute; left: 14px; top: 56px; }
  .c-logo { position: absolute; right: 6px; top: 6px; }
  .c-note { position: absolute; right: 0; bottom: 22px; }
  .c-spark { position: absolute; left: 0; bottom: 40px; width: 70px; height: 70px; }
  .collage .polaroid { width: 290px; padding: 12px 12px 14px; box-shadow: 0 14px 34px rgba(90,50,60,.2); rotate: -5deg; }
  .collage .polaroid img { height: 210px; object-position: 52% 30%; }
  .logo-sticker {
    width: 118px; height: 118px; border-radius: 50%;
    background: var(--cream); border: 4px solid #fff;
    box-shadow: 0 10px 26px rgba(90,50,60,.22);
    display: flex; align-items: center; justify-content: center;
    rotate: 9deg;
  }
  .logo-sticker img { width: 76px; height: 76px; object-fit: contain; }
  .note {
    position: relative;
    width: max-content; min-width: 210px;
    padding: 24px 30px 20px;
    background: var(--blush-3);
    white-space: nowrap;
    box-shadow: 0 10px 26px rgba(90,50,60,.18);
    rotate: 5deg;
    font-size: 23px; line-height: 1.1; color: #8E2F48; text-align: center;
  }
  @media (max-width: 480px) {
    .collage { height: 400px; }
    .collage .polaroid { width: 240px; }
    .collage .polaroid img { height: 170px; }
    .c-photo { left: 0; }
    .logo-sticker { width: 92px; height: 92px; }
    .logo-sticker img { width: 58px; height: 58px; }
    .note { min-width: 0; font-size: 20px; padding: 20px 22px 16px; }
  }

  /* Polaroids (hero + gallery) */
  .polaroid { margin: 0; position: relative; background: #fff; }
  .polaroid img { display: block; width: 100%; object-fit: cover; }
  .polaroid figcaption { font-size: 20px; text-align: center; padding: 10px 0 4px; color: var(--ink); }

  /* ---------- Marquee ---------- */
  .marquee {
    overflow: hidden;
    background: var(--rose); color: var(--cream);
    padding: 14px 0;
    border-block: 3px solid var(--ink);
    rotate: -1deg;
    margin: 8px -12px 0;
  }
  .marq-track { display: flex; width: max-content; font-family: var(--f-sub); font-style: italic; font-size: 31px; white-space: nowrap; }
  .marq-track span { padding-right: 36px; }

  /* ---------- What we do ---------- */
  .wwd { padding: clamp(48px, 7vw, 96px) var(--pad-x) clamp(40px, 6vw, 72px); }
  .intro { max-width: 760px; }
  .intro p { margin: 0 0 18px; font-size: 18px; line-height: 1.7; }
  .intro p.muted { margin: 0; color: var(--muted); }
  .stats { display: flex; flex-wrap: wrap; gap: 26px; margin-top: 52px; }
  .stat { flex: 1 1 200px; position: relative; border-radius: 6px; padding: 34px 22px 24px; box-shadow: 0 8px 24px rgba(90,50,60,.12); }
  .num { font-family: var(--f-sub); font-size: 74px; line-height: 1; color: var(--rose); outline-offset: 6px; }
  .stat-label { margin-top: 10px; font-weight: 500; line-height: 1.4; }
  .nominated { margin: 28px 0 0; font-size: 15px; color: var(--muted); }
  .pillars { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 40px; }
  .pillar { flex: 1 1 240px; position: relative; border-radius: 6px; padding: 34px 26px 28px; box-shadow: 0 8px 24px rgba(90,50,60,.12); }
  .pillar.drop { margin-top: 18px; }
  .pillar .no { font-size: 15px; color: var(--rose); }
  .pillar h3 { margin: 4px 0 8px; font-family: var(--f-sub); font-weight: 400; font-size: 34px; }
  .pillar p { margin: 0; line-height: 1.6; color: var(--muted); }
  .pillar.drop p { color: #5A4A4A; }

  /* ---------- Life at UQLIT ---------- */
  .moments { padding: clamp(40px, 6vw, 80px) var(--pad-x); }
  .kicker { font-size: 22px; color: var(--rose); rotate: -2deg; display: inline-block; }
  .gallery { display: flex; flex-wrap: wrap; gap: 36px 28px; margin-top: 44px; align-items: flex-start; }
  .gallery .polaroid { min-width: 0; padding: 12px 12px 8px; box-shadow: 0 10px 28px rgba(90,50,60,.16); }

  /* ---------- Upcoming ---------- */
  .upcoming { padding: clamp(40px, 6vw, 80px) var(--pad-x); background: var(--tint); scroll-margin-top: 40px; }
  .up-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 24px; }
  .btn.small { min-height: 46px; padding: 0 22px; }
  .cards { display: flex; flex-wrap: wrap; gap: 32px; margin-top: 44px; }
  .empty { margin: 36px 0 0; font-size: 21px; font-weight: 400; color: var(--muted); }
  .empty a { color: var(--rose); text-decoration: underline; }
  .empty[hidden] { display: none; }

  /* ---------- Motion ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .ch { display: inline-block; animation: chin .16s ease-out both; animation-delay: calc(var(--i) * 55ms + var(--pop-base, 0s) + .2s); }
    @keyframes chin { from { opacity: 0; transform: translateY(10px) scale(.8); } }
    .caret { opacity: 0; animation: blink 1s steps(1) infinite; animation-delay: calc(var(--n) * 55ms + var(--pop-base, 0s) + .3s); }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    .ul path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw .7s ease-out forwards; animation-delay: calc(var(--pop-base, 0s) + 1.1s); }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    .marq-track { animation: marq 34s linear infinite; }
    @keyframes marq { to { transform: translateX(-50%); } }
  }
</style>
