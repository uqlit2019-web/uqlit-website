---
import Desktop from '../../layouts/Desktop.astro';
import { jobs } from '../../data/jobs';

// Open postings first (soonest deadline first), closed ones at the end. The page script
// re-checks against today's date, since the site is built ahead of time.
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Australia/Brisbane' }).format(new Date());
const sorted = [...jobs].sort((a, b) => Number(a.due < today) - Number(b.due < today) || a.due.localeCompare(b.due));

const tilts = ['-2deg', '1.5deg', '-1deg', '2deg', '-1.5deg', '1deg'];
// Every few postings is taped up instead of pinned, and the pins come in retro colours
const pins = ['rose', 'gold', 'teal', 'rose', 'mauve'];
// Little handwritten notes stuck between the postings (after the posting at this position)
const notes = [
  { after: 1, cls: 'yellow', text: "tip: apply as early as you can, even if you don't tick every box ♡" },
  { after: 4, cls: 'pink', text: 'new roles pinned up as sponsors send them ♡' },
];
const fmtDue = (iso: string) =>
  new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`));
const fmtLong = (iso: string) =>
  new Intl.DateTimeFormat('en-AU', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`));

const filters = [
  { key: 'all', label: 'Everything' },
  { key: 'Internship', label: 'Internships' },
  { key: 'Graduate', label: 'Graduate roles' },
  { key: 'Program', label: 'Programs' },
  { key: 'soon', label: 'Closing soon' },
];
---

<Desktop page="jobs" title="Job Hub · UQLIT" windowTitle="Job Hub" description="Internships, graduate roles and programs from UQLIT's sponsor companies, with deadlines and links to apply.">
  <section class="intro">
    <div class="hand hi pop" style="--d: 0">straight from our sponsors</div>
    <h1 class="title pop" style="--d: 1">Job <em>Hub</em></h1>
    <p class="pop" style="--d: 2">Internships, grad roles and programs from the companies who support UQLIT. Tap a posting for the full details and the link to apply.</p>
  </section>

  <section class="board-sec">
    <!-- Folder-tab filters -->
    <div class="tabs rv" role="toolbar" aria-label="Filter postings">
      {filters.map((f, i) => (
        <button type="button" class="tab" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.key === 'soon' && <span class="tab-dot" aria-hidden="true"></span>}
          {f.label}
        </button>
      ))}
    </div>

    <!-- The pinboard collage -->
    <div class="board" id="board">
      {sorted.map((j, i) => (
        <Fragment>
        <a
          href={`#${j.id}`}
          class:list={['post', 'fall', i % 4 === 2 ? 'taped-up' : `pin-${pins[i % pins.length]}`]}
          style={`--d: ${i % 3}; rotate: ${tilts[i % tilts.length]}`}
          data-id={j.id}
          data-type={j.type}
          data-due={j.due}
          aria-label={`${j.title} at ${j.company}, applications close ${fmtLong(j.due)}`}
        >
          {i % 4 === 2
            ? <Fragment><span class="washi w1" aria-hidden="true"></span><span class="washi w2" aria-hidden="true"></span></Fragment>
            : <span class="pin" aria-hidden="true"></span>}
          <span class="frame">
            {j.graphic
              ? <img src={j.graphic} alt="" width={j.graphicW} height={j.graphicH} loading="lazy" />
              : <span class="ph"><img src={j.logo} alt="" /></span>}
            <span class="closed-stamp" aria-hidden="true">CLOSED</span>
          </span>
          <span class="meta">
            <span class="logo"><img src={j.logo} alt="" /></span>
            <span class="who">{j.company} · {j.type}</span>
            <strong class="role">{j.title}</strong>
          </span>
          <span class="stub">
            <span class="stub-l">Closes</span>
            <span class="stub-r"><span class="stub-date">{fmtDue(j.due)}</span><span class="left" data-left></span></span>
          </span>
        </a>
        {notes.filter((n) => n.after === i).map((n) => (
          <div class:list={['sticky', 'fall', n.cls]} style={`--d: ${(i + 1) % 3}`}><span class="hand">{n.text}</span></div>
        ))}
        </Fragment>
      ))}
    </div>
    <p class="hand empty" id="empty" hidden>nothing here right now. check back soon ♡</p>
  </section>

  <!-- Posting detail: opens as its own little window -->
  <dialog class="jwin" id="jwin" aria-labelledby="jw-title">
    <div class="jw-bar">
      <form method="dialog" class="jw-lights">
        <button class="l red" value="close" aria-label="Close"><span aria-hidden="true">×</span></button>
        <span class="l yel" aria-hidden="true"></span>
        <span class="l grn" aria-hidden="true"></span>
      </form>
      <span class="jw-name" id="jw-file"></span>
      <span class="jw-nav">
        <button type="button" id="jw-prev" aria-label="Previous posting">←</button>
        <button type="button" id="jw-next" aria-label="Next posting">→</button>
      </span>
    </div>
    <div class="jw-body">
      <figure class="jw-art">
        <img id="jw-img" alt="" />
        <span class="ph" id="jw-ph"><img id="jw-ph-logo" alt="" /></span>
        <a id="jw-full" target="_blank" rel="noopener">view full size ↗</a>
      </figure>
      <div class="jw-info">
        <div class="jw-co"><span class="logo"><img id="jw-logo" alt="" /></span><span id="jw-company"></span><span class="chip" id="jw-type"></span></div>
        <h2 id="jw-title"></h2>
        <div class="deadline" id="jw-deadline">
          <span class="cal-page" aria-hidden="true"><span id="jw-mon"></span><strong id="jw-day"></strong></span>
          <span class="dl-text">
            <span class="dl-label">Applications close</span>
            <strong id="jw-due"></strong>
            <span class="dl-left" id="jw-left"></span>
          </span>
          <a class="btn btn-primary jw-apply" id="jw-apply" target="_blank" rel="noopener"></a>
        </div>
        <h3 class="jw-h">About the role</h3>
        <div class="jw-desc" id="jw-desc"></div>
        <p class="jw-note">Posted exactly as provided by <span id="jw-co2"></span>. Questions about the role? Contact them directly.</p>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="jobs-data" set:html={JSON.stringify(sorted)} />
</Desktop>

<script>
  import type { JobPosting } from '../../data/jobs';

  const jobs: JobPosting[] = JSON.parse(document.getElementById('jobs-data')!.textContent || '[]');
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Australia/Brisbane' }).format(new Date());
  const daysLeft = (iso: string) => Math.round((Date.parse(`${iso}T00:00:00Z`) - Date.parse(`${today}T00:00:00Z`)) / 864e5);
  const leftText = (n: number) => (n < 0 ? 'closed' : n === 0 ? 'last day!' : n === 1 ? '1 day left' : `${n} days left`);
  const SOON = 7;

  // Countdowns + closed / closing-soon states on the board
  const board = document.getElementById('board')!;
  const posts = [...board.querySelectorAll<HTMLAnchorElement>('.post')];
  for (const p of posts) {
    const n = daysLeft(p.dataset.due!);
    p.classList.toggle('closed', n < 0);
    p.classList.toggle('soon', n >= 0 && n <= SOON);
    p.querySelector('[data-left]')!.textContent = leftText(n);
  }
  // Closed postings sink to the end
  posts.filter((p) => p.classList.contains('closed')).forEach((p) => board.append(p));

  // Filters
  const empty = document.getElementById('empty')!;
  document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab, _, all) =>
    tab.addEventListener('click', () => {
      all.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
      const f = tab.dataset.filter!;
      let shown = 0;
      for (const p of posts) {
        const keep = f === 'all' || (f === 'soon' ? p.classList.contains('soon') : p.dataset.type === f);
        p.hidden = !keep;
        if (keep) shown++;
      }
      empty.hidden = shown > 0;
    }),
  );

  // Detail window, driven by the URL hash so a posting can be shared as uqlit.com/jobs/#id
  const dlg = document.getElementById('jwin') as HTMLDialogElement;
  const $ = (id: string) => document.getElementById(id)!;
  const order = () => posts.filter((p) => !p.hidden).map((p) => p.dataset.id!);
  let current = '';

  function fill(j: JobPosting) {
    current = j.id;
    const n = daysLeft(j.due);
    $('jw-file').textContent = `${j.company} — ${j.title}`;
    const img = $('jw-img') as HTMLImageElement;
    img.hidden = !j.graphic;
    $('jw-full').hidden = !j.graphic;
    $('jw-ph').hidden = !!j.graphic;
    if (j.graphic) {
      img.src = j.graphic;
      img.alt = `${j.company}'s graphic for ${j.title}`;
      ($('jw-full') as HTMLAnchorElement).href = j.graphic;
    } else {
      ($('jw-ph-logo') as HTMLImageElement).src = j.logo;
    }
    ($('jw-logo') as HTMLImageElement).src = j.logo;
    $('jw-company').textContent = j.company;
    $('jw-co2').textContent = j.company;
    $('jw-type').textContent = j.type;
    $('jw-title').textContent = j.title;
    const due = new Date(`${j.due}T00:00:00Z`);
    const f = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-AU', { ...o, timeZone: 'UTC' }).format(due);
    $('jw-mon').textContent = f({ month: 'short' });
    $('jw-day').textContent = f({ day: 'numeric' });
    $('jw-due').textContent = f({ weekday: 'long', day: 'numeric', month: 'long' }) + (j.dueTime ? `, ${j.dueTime}` : '');
    $('jw-left').textContent = leftText(n);
    $('jw-deadline').className = `deadline${n < 0 ? ' closed' : n <= SOON ? ' soon' : ''}`;
    $('jw-desc').textContent = j.description; // as provided, never reformatted
    const apply = $('jw-apply') as HTMLAnchorElement;
    apply.href = j.applyUrl;
    apply.innerHTML = n < 0 ? 'Applications have closed' : `Apply at ${j.company.replace(/[&<>]/g, '')} <span aria-hidden="true">↗</span>`;
    apply.classList.toggle('off', n < 0);
    dlg.querySelector('.jw-info')!.scrollTop = 0;
    dlg.classList.remove('swap');
    void dlg.offsetWidth;
    dlg.classList.add('swap');
  }

  function route() {
    const j = jobs.find((x) => x.id === location.hash.slice(1));
    if (!j) { if (dlg.open) dlg.close(); return; }
    fill(j);
    if (!dlg.open) dlg.showModal();
  }
  dlg.addEventListener('close', () => {
    if (location.hash) history.pushState(null, '', location.pathname);
  });
  // click on the dimmed backdrop closes it
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  const step = (by: number) => {
    const ids = order();
    const next = ids[(ids.indexOf(current) + by + ids.length) % ids.length];
    history.replaceState(null, '', `#${next}`);
    route();
  };
  $('jw-prev').addEventListener('click', () => step(-1));
  $('jw-next').addEventListener('click', () => step(1));
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
  addEventListener('hashchange', route);
  route();
</script>

<style>
  .intro { position: relative; padding: clamp(32px, 5vw, 64px) var(--pad-x) clamp(12px, 2vw, 20px); }
  .hi { font-size: 23px; color: var(--rose); rotate: -2deg; display: inline-block; }
  .title { margin: 0; font-family: var(--f-head); font-weight: 400; font-size: clamp(44px, 6vw, 84px); line-height: 1.02; letter-spacing: -0.01em; }
  .title em { color: var(--rose); font-style: normal; }
  .intro p { margin: 16px 0 0; max-width: 560px; font-size: 18px; line-height: 1.6; color: var(--muted); }

  /* ---------- Folder-tab filters ---------- */
  .board-sec { padding: clamp(16px, 3vw, 28px) var(--pad-x) clamp(48px, 6vw, 80px); }
  .tabs { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; padding: 0 14px; position: relative; z-index: 1; }
  .tab {
    flex: none; display: inline-flex; align-items: center; gap: 8px;
    border: 0; padding: 11px 18px 9px; border-radius: 12px 12px 0 0;
    background: var(--blush-3); color: var(--rose);
    font: 700 14px/1 var(--f-body); cursor: var(--cursor-link);
    translate: 0 4px; transition: translate .2s, background .2s;
  }
  .tab:hover, .tab:focus-visible { translate: 0 0; }
  .tab[aria-pressed='true'] { background: #F4CDD6; color: var(--ink); translate: 0 0; }
  .tab-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--rose); }

  /* ---------- Pinboard ---------- */
  .board {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 52px 40px; align-items: start;
    padding: clamp(36px, 4vw, 52px) clamp(20px, 3vw, 44px) 32px;
    border-radius: 18px;
    background: radial-gradient(rgba(255,255,255,.75) 1.3px, transparent 2px) 0 0 / 16px 16px, #F4CDD6;
  }
  .post {
    position: relative; display: block;
    background: #fff; padding: 12px 12px 0;
    border-radius: 6px;
    box-shadow: 0 8px 22px rgba(150,60,85,.14);
    transition: rotate .35s cubic-bezier(.2,.9,.3,1.3), scale .35s cubic-bezier(.2,.9,.3,1.3), box-shadow .35s;
  }
  .post:hover, .post:focus-visible { rotate: 0deg !important; scale: 1.04; box-shadow: 0 16px 36px rgba(150,60,85,.2); z-index: 2; }
  .post[hidden] { display: none; }
  @media (min-width: 900px) { .board > :nth-child(3n+2) { margin-top: 30px; } }

  /* Push pin (new) */
  .pin {
    position: absolute; top: -9px; left: 50%; z-index: 3;
    width: 22px; height: 22px; margin-left: -11px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff 0 12%, var(--pc) 32%, var(--pd) 100%);
    box-shadow: 0 3px 5px rgba(120,40,70,.3);
  }
  .pin { --pc: #E58BA1; --pd: #B8405F; }
  .pin-gold .pin { --pc: #F7CF6E; --pd: #C98F14; }
  .pin-teal .pin { --pc: #7FD3C5; --pd: #2E8C7E; }
  .pin-mauve .pin { --pc: #B9A6E0; --pd: #6F58A8; }

  /* Washi tape on the corners (new) */
  .washi {
    position: absolute; z-index: 3; width: 74px; height: 22px; opacity: .92;
    background: repeating-linear-gradient(45deg, #F6C3CE 0 7px, #fff 7px 12px);
    box-shadow: 0 1px 3px rgba(90,50,60,.15);
  }
  .w1 { top: -9px; left: -18px; rotate: -38deg; }
  .w2 { top: -9px; right: -18px; rotate: 38deg; }

  /* Handwritten sticky notes between postings (new) */
  .sticky {
    align-self: center; justify-self: center;
    width: min(200px, 100%); aspect-ratio: 1 / 1; padding: 24px 20px;
    display: flex; align-items: center; justify-content: center; text-align: center;
    font-size: 21px; line-height: 1.25; color: var(--ink);
    box-shadow: 0 10px 18px rgba(150,60,85,.2);
    position: relative;
  }
  .sticky::before { content: ""; position: absolute; top: -10px; left: 50%; width: 70px; height: 22px; margin-left: -35px; background: repeating-linear-gradient(45deg, #F6C3CE 0 7px, #fff 7px 12px); opacity: .92; rotate: -4deg; box-shadow: 0 1px 3px rgba(90,50,60,.15); }
  .sticky.yellow { background: #FFE58A; rotate: 4deg; }
  .sticky.pink { background: #F9C6D3; rotate: -5deg; }

  .frame { position: relative; display: block; overflow: hidden; background: var(--blush-3); }
  .frame > img { display: block; width: 100%; height: auto; max-height: 400px; object-fit: cover; object-position: top; }

  .meta { display: grid; grid-template-columns: auto 1fr; column-gap: 12px; align-items: center; padding: 14px 4px 12px; }
  .logo {
    grid-row: span 2; width: 44px; height: 44px; border-radius: 50%; flex: none;
    display: flex; align-items: center; justify-content: center;
    background: #fff; border: 1.5px solid var(--blush-2);
  }
  .logo img { width: 28px; height: 28px; object-fit: contain; }
  .who { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--rose); }
  .role { font-size: 17px; line-height: 1.3; }

  /* Due date */
  .stub { display: flex; align-items: center; gap: 6px; margin: 0 -12px; padding: 10px 14px; border-top: 1.5px solid var(--blush-3); font-size: 13px; }
  .stub-l { color: var(--muted); }
  .stub-r { flex-grow: 1; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .stub-date { font-weight: 700; font-size: 14px; }
  .left { padding: 3px 10px; border-radius: 999px; background: var(--blush-3); color: #8E2F48; font-weight: 700; font-size: 12px; white-space: nowrap; }
  .soon .left { background: var(--rose); color: #fff; }

  /* Stand-in when a sponsor hasn't sent a graphic: their logo on blush */
  .ph {
    aspect-ratio: 1 / 1; width: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px;
    padding: 28px; text-align: center;
    background: var(--blush-3);
  }
  .ph img { width: 120px; height: 120px; object-fit: contain; padding: 14px; border-radius: 50%; background: #fff; box-shadow: 0 6px 16px rgba(90,50,60,.12); }

  /* Closed postings: faded, with a rubber stamp */
  .closed-stamp {
    position: absolute; top: 50%; left: 50%; translate: -50% -50%; rotate: -14deg;
    padding: 6px 18px; border: 4px solid var(--rose); border-radius: 8px;
    color: var(--rose); font: 800 28px/1 var(--f-body); letter-spacing: .2em;
    background: rgba(255,255,255,.8); opacity: 0;
  }
  .closed .frame > img, .closed .ph { filter: grayscale(1) opacity(.5); }
  .closed .closed-stamp { opacity: 1; }
  .closed .role, .closed .logo { opacity: .6; }
  .closed .left { background: #EEE6E6; color: var(--muted); }

  .empty { margin: 28px 0 0; font-size: 21px; font-weight: 400; color: var(--muted); text-align: center; }
  .empty[hidden] { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .post:hover .pin { animation: pinwig .5s ease; }
    @keyframes pinwig { 30% { rotate: -18deg; } 70% { rotate: 12deg; } }
    .soon .left { animation: nudge 2.4s ease-in-out infinite; }
    @keyframes nudge { 0%, 70%, 100% { scale: 1; } 80% { scale: 1.12; } 90% { scale: .96; } }
  }

  /* ---------- Detail window (new: a second little macOS window) ---------- */
  .jwin {
    width: min(1040px, calc(100% - 32px)); max-height: min(760px, calc(100dvh - 48px));
    padding: 0; border: 0; border-radius: 16px; overflow: hidden;
    background: var(--cream); color: var(--ink);
    box-shadow: 0 30px 80px rgba(60,25,40,.45), 0 0 0 1px rgba(120,106,106,.2);
  }
  .jwin[open] { display: flex; flex-direction: column; }
  .jwin::backdrop { background: rgba(90,50,60,.35); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
  .jw-bar {
    flex: none; position: relative; height: 44px; display: flex; align-items: center; gap: 14px; padding: 0 16px;
    border-bottom: 1px solid rgba(120,106,106,.14); background: rgba(255,255,255,.55);
  }
  .jw-lights { display: flex; gap: 8px; margin: 0; }
  .l { width: 13px; height: 13px; border-radius: 50%; border: 0; padding: 0; display: flex; align-items: center; justify-content: center; }
  .l.red { background: #FF5F57; cursor: var(--cursor-link); color: transparent; font: 700 11px/1 var(--f-body); }
  .l.red:hover, .l.red:focus-visible { color: rgba(80,0,0,.7); }
  .l.yel { background: #FEBC2E; } .l.grn { background: #28C840; }
  .jw-name { flex-grow: 1; min-width: 0; text-align: center; font-size: 13px; font-weight: 600; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .jw-nav { display: flex; gap: 6px; }
  .jw-nav button {
    width: 30px; height: 30px; border: 0; border-radius: 50%; background: var(--blush-3); color: var(--rose);
    font: 700 15px/1 var(--f-body); cursor: var(--cursor-link); transition: scale .2s;
  }
  .jw-nav button:hover, .jw-nav button:focus-visible { scale: 1.12; }

  .jw-body { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); }
  .jw-art {
    margin: 0; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
    padding: 28px; background: var(--tint);
  }
  .jw-art > img {
    display: block; max-width: 100%; max-height: calc(min(760px, 100dvh - 48px) - 44px - 100px); width: auto; height: auto; object-fit: contain;
    background: #fff; padding: 10px; box-shadow: 0 12px 30px rgba(90,50,60,.2); rotate: -1.5deg;
  }
  .jw-art .ph { width: min(380px, 100%); box-shadow: 0 12px 30px rgba(90,50,60,.2); rotate: -1.5deg; border: 10px solid #fff; }
  .jw-art [hidden] { display: none; }
  .jw-art a { font-size: 13px; font-weight: 700; color: var(--rose); }
  .jw-art a:hover { text-decoration: underline; }

  .jw-info { min-height: 0; overflow-y: auto; padding: 30px clamp(22px, 3vw, 40px) 30px; }
  .jw-co { display: flex; align-items: center; gap: 12px; font-weight: 700; }
  .jw-co .logo {
    width: 44px; height: 44px; border-radius: 50%; flex: none;
    display: flex; align-items: center; justify-content: center;
    background: #fff; box-shadow: 0 3px 8px rgba(90,50,60,.16);
  }
  .jw-co .logo img { width: 28px; height: 28px; object-fit: contain; }
  .chip { padding: 4px 12px; border-radius: 999px; background: var(--blush-3); color: #8E2F48; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .jw-info h2 { margin: 16px 0 18px; font-family: var(--f-sub); font-weight: 400; font-size: clamp(32px, 3.6vw, 44px); line-height: 1.08; }

  /* Deadline + Apply, side by side near the top */
  .deadline {
    display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px;
    padding: 16px 18px; border-radius: 16px;
    background: #fff; box-shadow: 0 6px 18px rgba(90,50,60,.1);
  }
  /* Tear-off calendar page, like the dates on the event cards */
  .cal-page {
